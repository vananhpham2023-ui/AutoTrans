  # 载机状态（来自 /visual_slam/odom 和 /drone_imu/data）
  - quad_pos: [x, y, z]                    # 位置
  - quad_vel: [vx, vy, vz]                 # 速度
  - quad_quat: [R13，R23，R33]             # 旋转矩阵第1行第3列、第2行第3列、第3行第3列的元素
  - quad_omega: [wx, wy, wz]               # 角速度（来自IMU）
  - quad_acc_body: [ax, ay, az]            # 加速度（机体系，来自IMU）

  # 负载状态（来自 /payload_odom 和 /load_imu/data）
  - load_pos: [x, y, z]
  - load_vel: [vx, vy, vz]
  - load_acc_body: [ax, ay, az]

  # 缆绳信息（来自 /cable_info/data）
  - cable_dir: [nx, ny, nz]                # 单位方向向量

  # 参数常量（从config读取，每个场景记录一次）
  - mass_quad, mass_load, L_length, sqrt_kf

  输出标签（Ground Truth）：
  - fl_true: [fx, fy, fz]                  # 负载外力真值
  - fq_true: [fx, fy, fz]                  # 载机外力真值

  辅助信息（用于分析和对比）：
  - wind: [wx, wy, wz]                     # 风速（如果启用）
  - fl_est_lbfgs: [fx, fy, fz]            # L-BFGS估计值（基线对比）
  - fq_est_lbfgs: [fx, fy, fz]

  2.2 数据预处理策略

  # 归一化方案（基于物理范围）
  position: [-10, 10] m → [-1, 1]
  velocity: [-5, 5] m/s → [-1, 1]
  quaternion: 保持单位范数（无需归一化）
  angular_velocity: [-3, 3] rad/s → [-1, 1]
  acceleration: [-20, 20] m/s² → [-1, 1]
  cable_dir: 单位向量（无需归一化）
  force: [-30, 30] N → [-1, 1]

  # 时序特征工程（如果使用历史窗口）
  window_size = 10  # 0.1秒历史（100Hz）
  stride = 1        # 滑动步长

  3. PINN网络架构建议
● 3.1 PINN架构设计（两种方案）
  方案A：物理约束损失型MLP（推荐用于baseline）
  网络结构：
  Input (dim=37): [quad_state(16) + load_state(16) + cable_dir(3) + thrust(1) + params(1)]
    ↓
  Hidden Layer 1 (128) + LayerNorm + ReLU + Dropout(0.1)
    ↓
  Hidden Layer 2 (128) + LayerNorm + ReLU + Dropout(0.1)
    ↓
  Hidden Layer 3 (64) + LayerNorm + ReLU
    ↓
  Output (6): [fl_x, fl_y, fl_z, fq_x, fq_y, fq_z]

  损失函数：
  L_total = λ_data * L_data + λ_physics * L_physics
  L_data = MSE(fl_pred, fl_true) + MSE(fq_pred, fq_true)
  L_physics = 物理残差的平方和：
    # 从加速度推导的系统总力
    F_total_measured = m_q * a_q + m_l * a_l - T_vec
    # 从估计外力推导的总力
    F_total_estimated = fl_pred + fq_pred
    # 物理一致性损失
    L_physics = ||F_total_measured - F_total_estimated||²

  超参数：
  λ_data = 1.0, λ_physics = 0.1（可调）

  优点：
  - 结构简单，易于训练和调试
  - 计算高效（~0.1ms推理时间）
  - 物理约束作为软约束，允许噪声

  缺点：
  - 不能保证严格满足物理定律

  方案B：时序PINN（LSTM/GRU，用于捕捉动态）

  Input sequence (window_size=10, dim=37)
    ↓
  LSTM/GRU Layer (hidden=64, layers=2)
    ↓
  取最后时刻输出 → MLP (64→32→6)
    ↓
  Output (6): [fl, fq]

  损失函数：同方案A

  超参数：
  window_size = 10 (0.1秒历史)

  优点：
  - 捕捉系统动态和历史依赖
  - 可能对快速机动更鲁棒

  缺点：
  - 推理时间较长（~1-2ms）
  - 需要维护历史窗口

  推荐策略：
  1. 第一阶段： 方案A（快速验证可行性）
  2. 第二阶段： 方案B（提升性能）
  3. 最终对比： 两种方案 + L-BFGS基线

