Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Controller
      Splitter Ratio: 0.5
    Tree Height: 500
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Name: Tool Properties
    Splitter Ratio: 0.55
  - Class: rviz/Views
    Name: Views
  - Class: rviz/Time
    Name: Time
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 160
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Plane: XY
      Plane Cell Count: 100
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/Group
      Displays:
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /mpc_controller_node/mpc/force_marker
          Name: ForceMarker
          Queue Size: 50
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 0; 136; 204
          Enabled: true
          Line Style: Lines
          Line Width: 0.05
          Name: ReferencePath
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 255; 255; 255
          Pose Style: None
          Topic: /mpc_controller_node/mpc/reference_trajectory
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 238; 46; 47
          Enabled: true
          Line Style: Lines
          Line Width: 0.05
          Name: PredictedPath
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 255; 255; 255
          Pose Style: None
          Topic: /mpc_controller_node/mpc/trajectory_predicted
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 255; 170; 0
          Enabled: true
          Line Style: Lines
          Line Width: 0.05
          Name: PayloadReference
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 255; 255; 255
          Pose Style: None
          Topic: /mpc_controller_node/mpc/reference_payload_trajectory
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 153; 102; 204
          Enabled: true
          Line Style: Lines
          Line Width: 0.05
          Name: PayloadPredicted
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 255; 255; 255
          Pose Style: None
          Topic: /mpc_controller_node/mpc/payload_trajectory_predicted
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /mpc_controller_node/mpc/reference_geometry
          Name: Geometry
          Queue Size: 1
          Value: true
      Enabled: true
      Name: Controller
      Value: true
  Enabled: true
  Global Options:
    Background Color: 255; 255; 255
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 20
      Focal Point:
        X: 0
        Y: 0
        Z: 2
      Name: Orbit
      Near Clip Distance: 0.01
      Pitch: 1.2
      Target Frame: world
      Yaw: 0.5
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 
  Width: 1600
  X: 100
  Y: 50
