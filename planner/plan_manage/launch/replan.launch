<launch>
  <arg name="map_size_x" value="35.0"/>
  <arg name="map_size_y" value="15.0"/>
  <arg name="map_size_z" value=" 3.2"/>
  <arg name="init_x" default="-15.0"/>
  <arg name="init_y" default="-1.0"/>
  <arg name="init_z" default="1.5"/>

  <arg name="odom_topic" value="visual_slam/odom" />
  <arg name="payload_odom_topic" value="payload_odom" />
  <arg name="use_planner" default="true"/>
  <arg name="trajectory_mode" default="circle"/>
  <arg name="circle_radius" default="5.0"/>
  <arg name="circle_omega" default="0.5"/>
  <arg name="circle_center_x" default="0.0"/>
  <arg name="circle_center_y" default="0.0"/>
  <arg name="circle_altitude" default="2.0"/>
  <arg name="figure_radius" default="5.0"/>
  <arg name="figure_omega" default="0.5"/>
  <arg name="figure_center_x" default="0.0"/>
  <arg name="figure_center_y" default="0.0"/>
  <arg name="figure_altitude" default="2.0"/>
  <arg name="helix_radius" default="4.0"/>
  <arg name="helix_omega" default="0.4"/>
  <arg name="helix_center_x" default="0.0"/>
  <arg name="helix_center_y" default="0.0"/>
  <arg name="helix_base_altitude" default="1.5"/>
  <arg name="helix_vertical_rate" default="0.4"/>
  <arg name="helix_revolutions" default="3.0"/>
  <arg name="wind_type" default="none"/>
  <arg name="wind_constant_velocity" default="[0.0,0.0,0.0]"/>
  <arg name="wind_gust_axis" default="[1.0,0.0,0.0]"/>
  <arg name="wind_dryden_sigma" default="[0.0,0.0,0.0]"/>
  <arg name="wind_dryden_length_scale" default="[50.0,50.0,20.0]"/>
  <arg name="wind_override_yaml" default="{}"/>
  <!-- Gradual mean-wind ramp -->
  <arg name="wind_gradual_enabled" default="false"/>
  <arg name="wind_gradual_start_time" default="0.0"/>
  <arg name="wind_gradual_stop_time" default="0.0"/>
  <arg name="wind_gradual_cycle_profile_enabled" default="false"/>
  <arg name="wind_gradual_ramp_up_time" default="0.004"/>
  <arg name="wind_gradual_ramp_down_time" default="0.004"/>
  <!-- Wind window (hard on/off gate) -->
  <arg name="wind_window_enabled" default="false"/>
  <arg name="wind_window_auto_from_cycle" default="false"/>
  <arg name="wind_window_skip_cycles" default="0"/>
  <arg name="wind_window_active_cycles" default="0"/>
  <arg name="wind_window_cycle_time" default="0.0"/>
  <arg name="wind_window_start_time" default="$(arg warmup_trim)"/>
  <arg name="wind_window_stop_time" default="0.0"/>
  <!-- Analytics / recording warmup trim (seconds ignored before analytics/export) -->
  <arg name="warmup_trim" default="0.0"/>
  <arg name="analytic_target_cycles" default="3"/>

  <!-- map and planner -->
  <remap from="/traj_start_trigger" to="/move_base_simple/goal"/>
  <group if="$(arg use_planner)">
    <node pkg ="map_generator" name ="random_forest" type ="random_forest" output = "screen">
      <param name="map/x_size" value="25.0" />
      <param name="map/y_size" value="10.0" />
      <param name="map/z_size" value="3.0" />
      <param name="map/resolution" value="0.1"/>
      <param name="map/seed" value="0"/>
      <param name="ObstacleShape/seed" value="0"/>

      <param name="map/obs_num" value="70"/>

      <param name="ObstacleShape/lower_rad" value="0.5"/>
      <param name="ObstacleShape/upper_rad" value="0.5"/>
      <param name="ObstacleShape/lower_hei" value="2.0"/>
      <param name="ObstacleShape/upper_hei" value="3.0"/>

      <param name="map/circle_num" value="0"/>
      <param name="ObstacleShape/radius_l" value="1.0"/>
      <param name="ObstacleShape/radius_h" value="1.2"/>
      <param name="ObstacleShape/z_l" value="0.3"/>
      <param name="ObstacleShape/z_h" value="3.0"/>
      <param name="ObstacleShape/theta" value="0.5"/>

      <param name="pub_rate" value="1.0"/>
      <param name="min_distance" value="1.4"/>
    </node>

    <!-- main algorithm params -->
    <include file="$(find payload_planner)/launch/planning_node_params.xml">
      <arg name="map_size_x_" value="$(arg map_size_x)"/>
      <arg name="map_size_y_" value="$(arg map_size_y)"/>
      <arg name="map_size_z_" value="$(arg map_size_z)"/>

      <!-- camera pose: transform of camera frame in the world frame -->
      <!-- depth topic: depth image, 640x480 by default -->
      <!-- don't set cloud_topic if you already set these ones! -->
      <arg name="odometry_topic" value="$(arg odom_topic)"/>
      <arg name="payload_odometry_topic" value="$(arg payload_odom_topic)"/>
      <arg name="camera_pose_topic" value="pcl_render_node/camera_pose"/>
      <arg name="depth_topic" value="pcl_render_node/depth"/>
      <!-- topic of point cloud measurement, such as from LIDAR  -->
      <!-- don't set camera pose and depth, if you already set this one! -->
      <arg name="cloud_topic" value="pcl_render_node/cloud"/>
      <!-- intrinsic params of the depth camera -->
      <arg name="cx" value="321.04638671875"/>
      <arg name="cy" value="243.44969177246094"/>
      <arg name="fx" value="387.229248046875"/>
      <arg name="fy" value="387.229248046875"/>
      <!-- maximum velocity and acceleration the drone will reach -->
      <arg name="max_vel" value="2.5" />
      <arg name="max_acc" value="3.0" />
      <!--always set to 1.5 times grater than sensing horizen-->
      <arg name="planning_horizon" value="7.5" />
      <!-- 3: use global waypoints  -->
      <!-- 2: Only use the first waypoint as the goal -->
      <!-- 1: use 2D Nav Goal to select goal (Height is the first waypoint's height)-->
      <arg name="flight_type" value="1" />

    </include>
  </group>

  <arg name="mpc_config" default="$(find payload_mpc_controller)/config/mpc.yaml"/>

  <node pkg="payload_mpc_controller" type="mpc_controller_node" name="mpc_controller_node" output="screen">
    <rosparam command="load" file="$(arg mpc_config)" />
    <rosparam command="load" file="$(find payload_mpc_controller)/config/model.yaml" />
    <remap from="~odom" to="$(arg odom_topic)"/>
    <remap from="~drone_imu/data" to="imu"/>
    <remap from="~cable_info/data" to="cable_info"/>
    <remap from="~payload_odom" to="$(arg payload_odom_topic)"/>
    <remap from="~load_imu/data" to="load_imu"/>
    <remap from="/mavros/esc_telemetry" to="rpm" />

    <remap from="~traj" to="planning/trajectory" if="$(arg use_planner)"/>
    <remap from="/mavros/setpoint_raw/attitude" to="so3cmd"/>

    <remap from="~start_trigger" to="/move_base_simple/goal" if="$(arg use_planner)"/>
    <remap from="~cmd_trigger" to="/hummingbird/goal" if="$(arg use_planner)"/>

    <param name="reference/use_planner" value="$(arg use_planner)"/>
    <param name="reference/mode" value="$(arg trajectory_mode)"/>
    <param name="reference/circle/radius" value="$(arg circle_radius)"/>
    <param name="reference/circle/angular_velocity" value="$(arg circle_omega)"/>
    <param name="reference/circle/center" value="[ $(arg circle_center_x), $(arg circle_center_y) ]"/>
    <param name="reference/circle/altitude" value="$(arg circle_altitude)"/>
    <param name="reference/figure_eight/radius" value="$(arg figure_radius)"/>
    <param name="reference/figure_eight/angular_velocity" value="$(arg figure_omega)"/>
    <param name="reference/figure_eight/center" value="[ $(arg figure_center_x), $(arg figure_center_y) ]"/>
    <param name="reference/figure_eight/altitude" value="$(arg figure_altitude)"/>
    <param name="reference/helix/radius" value="$(arg helix_radius)"/>
    <param name="reference/helix/angular_velocity" value="$(arg helix_omega)"/>
    <param name="reference/helix/center" value="[ $(arg helix_center_x), $(arg helix_center_y) ]"/>
    <param name="reference/helix/base_altitude" value="$(arg helix_base_altitude)"/>
    <param name="reference/helix/vertical_rate" value="$(arg helix_vertical_rate)"/>
    <param name="reference/helix/revolutions" value="$(arg helix_revolutions)"/>
    <!-- Seconds to ignore before starting MPC analytics / cycle counting -->
    <param name="warmup_trim" value="$(arg warmup_trim)"/>
    <param name="analytic_target_cycles" value="$(arg analytic_target_cycles)"/>

  </node>

  <node pkg="payload_mpc_controller" type="force_data_recorder.py" name="force_data_recorder" output="screen">
    <param name="cycles_to_report" value="3" />
    <param name="enable_plot" value="true" />
    <param name="sync_slop" value="0.05" />
    <param name="sync_queue" value="200" />
    <param name="wind_topic" value="/so3_quadrotor/wind" />
    <param name="warmup_trim" value="$(arg warmup_trim)"/>
  </node>

  <!-- use simulator -->
  <include file="$(find payload_planner)/launch/simulator.xml">
    <arg name="map_size_x_" value="$(arg map_size_x)"/>
    <arg name="map_size_y_" value="$(arg map_size_y)"/>
    <arg name="map_size_z_" value="$(arg map_size_z)"/>
    <arg name="init_x" value="$(arg init_x)"/>
    <arg name="init_y" value="$(arg init_y)"/>
    <arg name="init_z" value="$(arg init_z)"/>
    <arg name="odometry_topic" value="$(arg odom_topic)" />
    <arg name="payload_odometry_topic" value="$(arg payload_odom_topic)" />
    <arg name="wind_type" value="$(arg wind_type)" />
    <arg name="wind_constant_velocity" value="$(arg wind_constant_velocity)" />
    <arg name="wind_gust_axis" value="$(arg wind_gust_axis)" />
    <arg name="wind_dryden_sigma" value="$(arg wind_dryden_sigma)" />
    <arg name="wind_dryden_length_scale" value="$(arg wind_dryden_length_scale)" />
    <arg name="wind_override_yaml" value="$(arg wind_override_yaml)" />
    <arg name="wind_gradual_enabled" value="$(arg wind_gradual_enabled)" />
    <arg name="wind_gradual_start_time" value="$(arg wind_gradual_start_time)" />
    <arg name="wind_gradual_stop_time" value="$(arg wind_gradual_stop_time)" />
    <arg name="wind_gradual_cycle_profile_enabled" value="$(arg wind_gradual_cycle_profile_enabled)" />
    <arg name="wind_gradual_ramp_up_time" value="$(arg wind_gradual_ramp_up_time)" />
    <arg name="wind_gradual_ramp_down_time" value="$(arg wind_gradual_ramp_down_time)" />
    <arg name="wind_window_enabled" value="$(arg wind_window_enabled)" />
    <arg name="wind_window_auto_from_cycle" value="$(arg wind_window_auto_from_cycle)" />
    <arg name="wind_window_skip_cycles" value="$(arg wind_window_skip_cycles)" />
    <arg name="wind_window_active_cycles" value="$(arg wind_window_active_cycles)" />
    <arg name="wind_window_cycle_time" value="$(arg wind_window_cycle_time)" />
    <arg name="wind_window_start_time" value="$(arg wind_window_start_time)" />
    <arg name="wind_window_stop_time" value="$(arg wind_window_stop_time)" />
    <arg name="warmup_trim" value="$(arg warmup_trim)" />
  </include>

  <group if="$(arg use_planner)">
    <include file="$(find payload_planner)/launch/rviz.launch">
      <arg name="config" value="$(find payload_planner)/launch/sim_vis.rviz"/>
    </include>
  </group>
  <group unless="$(arg use_planner)">
    <include file="$(find payload_planner)/launch/rviz.launch">
      <arg name="config" value="$(find payload_planner)/launch/controller_only.rviz"/>
    </include>
  </group>
</launch>
