  <arg name="wind_override_yaml_resolved" default="$(eval ('{dryden: {seed: %d}}' % {'c1_low':2101, 'c2_medium':2102, 'c3_high':2103, 'w1_medium_high':3006, 'w1_medium_low':3004, 'w1_medium_medium':3005, 'w1_strong_high':3009, 'w1_strong_low':3007, 'w1_strong_medium':3008, 'w1_weak_high':3003, 'w1_weak_low':3001, 'w1_weak_medium':3002, 'w2_medium_high':3015, 'w2_medium_low':3013, 'w2_medium_medium':3014, 'w2_strong_high':3018, 'w2_strong_low':3016, 'w2_strong_medium':3017, 'w2_weak_high':3012, 'w2_weak_low':3010, 'w2_weak_medium':3011, 'w3_medium_high':3024, 'w3_medium_low':3022, 'w3_medium_medium':3023, 'w3_strong_high':3027, 'w3_strong_low':3025, 'w3_strong_medium':3026, 'w3_weak_high':3021, 'w3_weak_low':3019, 'w3_weak_medium':3020, 'w4_medium_high':3033, 'w4_medium_low':3031, 'w4_medium_medium':3032, 'w4_strong_high':3036, 'w4_strong_low':3034, 'w4_strong_medium':3035, 'w4_weak_high':3030, 'w4_weak_low':3028, 'w4_weak_medium':3029, 'w5_medium_high':3042, 'w5_medium_low':3040, 'w5_medium_medium':3041, 'w5_strong_high':3045, 'w5_strong_low':3043, 'w5_strong_medium':3044, 'w5_weak_high':3039, 'w5_weak_low':3037, 'w5_weak_medium':3038, 'w6_medium_high':3051, 'w6_medium_low':3049, 'w6_medium_medium':3050, 'w6_strong_high':3054, 'w6_strong_low':3052, 'w6_strong_medium':3053, 'w6_weak_high':3048, 'w6_weak_low':3046, 'w6_weak_medium':3047}[arg('wind_preset')]) if arg('wind_preset') in {'c1_low', 'c2_medium', 'c3_high', 'w1_weak_low', 'w1_weak_medium', 'w1_weak_high', 'w1_medium_low', 'w1_medium_medium', 'w1_medium_high', 'w1_strong_low', 'w1_strong_medium', 'w1_strong_high', 'w2_weak_low', 'w2_weak_medium', 'w2_weak_high', 'w2_medium_low', 'w2_medium_medium', 'w2_medium_high', 'w2_strong_low', 'w2_strong_medium', 'w2_strong_high', 'w3_weak_low', 'w3_weak_medium', 'w3_weak_high', 'w3_medium_low', 'w3_medium_medium', 'w3_medium_high', 'w3_strong_low', 'w3_strong_medium', 'w3_strong_high', 'w4_weak_low', 'w4_weak_medium', 'w4_weak_high', 'w4_medium_low', 'w4_medium_medium', 'w4_medium_high', 'w4_strong_low', 'w4_strong_medium', 'w4_strong_high', 'w5_weak_low', 'w5_weak_medium', 'w5_weak_high', 'w5_medium_low', 'w5_medium_medium', 'w5_medium_high', 'w5_strong_low', 'w5_strong_medium', 'w5_strong_high', 'w6_weak_low', 'w6_weak_medium', 'w6_weak_high', 'w6_medium_low', 'w6_medium_medium', 'w6_medium_high', 'w6_strong_low', 'w6_strong_medium', 'w6_strong_high'} else arg('wind_override_yaml'))"/>

  <include file="$(find payload_planner)/launch/replan.launch">
    <arg name="use_planner" value="false"/>
    <arg name="trajectory_mode" value="$(arg trajectory_mode_resolved)"/>
    <arg name="circle_radius" value="$(arg circle_radius_resolved)"/>
    <arg name="circle_omega" value="$(arg circle_omega_resolved)"/>
    <arg name="circle_center_x" value="$(arg circle_center_x_resolved)"/>
    <arg name="circle_center_y" value="$(arg circle_center_y_resolved)"/>
    <arg name="circle_altitude" value="$(arg circle_altitude_resolved)"/>
    <arg name="figure_radius" value="$(arg figure_radius_resolved)"/>
    <arg name="figure_omega" value="$(arg figure_omega_resolved)"/>
    <arg name="figure_center_x" value="$(arg figure_center_x_resolved)"/>
    <arg name="figure_center_y" value="$(arg figure_center_y_resolved)"/>
    <arg name="figure_altitude" value="$(arg figure_altitude_resolved)"/>
    <arg name="helix_radius" value="$(arg helix_radius_resolved)"/>
    <arg name="helix_omega" value="$(arg helix_omega_resolved)"/>
    <arg name="helix_center_x" value="$(arg helix_center_x_resolved)"/>
    <arg name="helix_center_y" value="$(arg helix_center_y_resolved)"/>
    <arg name="helix_base_altitude" value="$(arg helix_base_altitude_resolved)"/>
    <arg name="helix_vertical_rate" value="$(arg helix_vertical_rate_resolved)"/>
    <arg name="helix_revolutions" value="$(arg helix_revolutions_resolved)"/>
    <arg name="init_x" value="$(arg init_x)"/>
    <arg name="init_y" value="$(arg init_y)"/>
    <arg name="init_z" value="$(arg init_z)"/>
    <arg name="wind_type" value="$(arg wind_type_resolved)"/>
    <arg name="wind_constant_velocity" value="$(arg wind_constant_velocity_resolved)"/>
    <arg name="wind_gust_axis" value="$(arg wind_gust_axis)"/>
    <arg name="wind_dryden_sigma" value="$(arg wind_dryden_sigma_resolved)"/>
    <arg name="wind_dryden_length_scale" value="$(arg wind_dryden_length_scale_resolved)"/>
    <arg name="wind_override_yaml" value="$(arg wind_override_yaml_resolved)"/>
  </include>

  <!-- Pinn data recorder is launched externally (e.g., via batch_data_collection.py) -->
</launch>
