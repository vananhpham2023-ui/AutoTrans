<launch>
  <arg name="trajectory_mode" default="circle"/>
  <arg name="circle_radius" default="5.0"/>
  <arg name="circle_omega" default="0.5"/>
  <arg name="circle_center_x" default="0.0"/>
  <arg name="circle_center_y" default="0.0"/>
  <arg name="circle_altitude" default="2.0"/>
  <arg name="figure_radius" default="5.0"/>
  <arg name="figure_omega" default="0.5"/>
  <arg name="figure_center_x" default="0.0"/>
  <arg name="figure_center_y" default="0.0"/>
  <arg name="figure_altitude" default="2.0"/>
  <arg name="helix_radius" default="4.0"/>
  <arg name="helix_omega" default="0.4"/>
  <arg name="helix_center_x" default="0.0"/>
  <arg name="helix_center_y" default="0.0"/>
  <arg name="helix_base_altitude" default="1.5"/>
  <arg name="helix_vertical_rate" default="0.4"/>
  <arg name="helix_revolutions" default="3.0"/>
  <arg name="init_x" default="5.0"/>
  <arg name="init_y" default="0.0"/>
  <arg name="init_z" default="2.0"/>
  <arg name="wind_type" default="none"/>
  <arg name="wind_constant_velocity" default="[0.0,0.0,0.0]"/>
  <arg name="wind_gust_axis" default="[1.0,0.0,0.0]"/>
  <arg name="wind_dryden_sigma" default="[0.0,0.0,0.0]"/>
  <arg name="wind_dryden_length_scale" default="[50.0,50.0,20.0]"/>
  <arg name="wind_override_yaml" default="{}"/>

  <!-- Scenario presets -->
  <arg name="scenario" default="custom"/>
  <arg name="trajectory_preset" default="$(eval ('custom' if arg('scenario')=='custom' or '.' not in arg('scenario') else arg('scenario').split('.',1)[0]))"/>
  <arg name="wind_preset" default="$(eval ('custom' if arg('scenario')=='custom' or '.' not in arg('scenario') else arg('scenario').split('.',1)[1]))"/>

  <!-- Run tagging & output layout -->
  <arg name="payload_mpc_controller_dir" default="$(find payload_mpc_controller)"/>
  <arg name="run_label" default="$(eval arg('scenario') if arg('scenario')!='custom' else 'manual')"/>
  <arg name="run_label_clean" default="$(eval ''.join([c if (c.isalnum() or c in '-_') else '-' for c in arg('run_label')]))"/>
  <arg name="run_seed" default="$(anon run)"/>
  <arg name="run_tag" default="$(eval (arg('run_label_clean') if arg('run_label_clean') else 'run') + '_' + arg('run_seed'))"/>
  <arg name="run_output_root" default="$(eval arg('payload_mpc_controller_dir') + '/plots/run_' + arg('run_tag'))"/>
  <arg name="force_output_dir" default="$(eval arg('run_output_root') + '/force')"/>
  <arg name="pinn_output_dir" default="$(eval arg('run_output_root') + '/pinn')"/>
  <arg name="analytic_output_dir" default="$(eval arg('run_output_root') + '/analytic')"/>

  <!-- Environment for downstream recorders -->
  <env name="AUTOTRANS_RUN_TAG" value="$(arg run_tag)"/>
  <env name="AUTOTRANS_ANALYTIC_DIR" value="$(arg analytic_output_dir)"/>
  <env name="FORCE_DATA_OUTPUT" value="$(arg force_output_dir)"/>
  <env name="PINN_DATA_OUTPUT" value="$(arg pinn_output_dir)"/>
  <env name="PINN_SCENARIO_ID" value="$(arg scenario)"/>

  <!-- Trajectory presets (resolved values) -->
  <arg name="trajectory_mode_resolved" default="$(eval {'circle':'circle','figure_eight':'figure_eight','helix':'helix'}.get(arg('trajectory_preset'), arg('trajectory_mode')))"/>
  <arg name="circle_radius_resolved" default="$(eval '3.0' if arg('trajectory_preset')=='circle' else arg('circle_radius'))"/>
  <arg name="circle_omega_resolved" default="$(eval '0.5' if arg('trajectory_preset')=='circle' else arg('circle_omega'))"/>
  <arg name="circle_center_x_resolved" default="$(eval '0.0' if arg('trajectory_preset')=='circle' else arg('circle_center_x'))"/>
  <arg name="circle_center_y_resolved" default="$(eval '0.0' if arg('trajectory_preset')=='circle' else arg('circle_center_y'))"/>
  <arg name="circle_altitude_resolved" default="$(eval '2.0' if arg('trajectory_preset')=='circle' else arg('circle_altitude'))"/>

  <arg name="figure_radius_resolved" default="$(eval '3.0' if arg('trajectory_preset')=='figure_eight' else arg('figure_radius'))"/>
  <arg name="figure_omega_resolved" default="$(eval '0.3' if arg('trajectory_preset')=='figure_eight' else arg('figure_omega'))"/>
  <arg name="figure_center_x_resolved" default="$(eval '0.0' if arg('trajectory_preset')=='figure_eight' else arg('figure_center_x'))"/>
  <arg name="figure_center_y_resolved" default="$(eval '0.0' if arg('trajectory_preset')=='figure_eight' else arg('figure_center_y'))"/>
  <arg name="figure_altitude_resolved" default="$(eval '2.0' if arg('trajectory_preset')=='figure_eight' else arg('figure_altitude'))"/>

  <arg name="helix_radius_resolved" default="$(eval '2.5' if arg('trajectory_preset')=='helix' else arg('helix_radius'))"/>
  <arg name="helix_omega_resolved" default="$(eval '0.4' if arg('trajectory_preset')=='helix' else arg('helix_omega'))"/>
  <arg name="helix_center_x_resolved" default="$(eval '0.0' if arg('trajectory_preset')=='helix' else arg('helix_center_x'))"/>
  <arg name="helix_center_y_resolved" default="$(eval '0.0' if arg('trajectory_preset')=='helix' else arg('helix_center_y'))"/>
  <arg name="helix_base_altitude_resolved" default="$(eval '1.5' if arg('trajectory_preset')=='helix' else arg('helix_base_altitude'))"/>
  <arg name="helix_vertical_rate_resolved" default="$(eval '0.2' if arg('trajectory_preset')=='helix' else arg('helix_vertical_rate'))"/>
  <arg name="helix_revolutions_resolved" default="$(eval '3.0' if arg('trajectory_preset')=='helix' else arg('helix_revolutions'))"/>

  <!-- Wind presets (resolved values) -->
  <arg name="wind_type_resolved" default="$(eval {'c1_low':'dryden', 'c2_medium':'dryden', 'c3_high':'dryden', 'w1_medium_high':'composite', 'w1_medium_low':'composite', 'w1_medium_medium':'composite', 'w1_strong_high':'composite', 'w1_strong_low':'composite', 'w1_strong_medium':'composite', 'w1_weak_high':'composite', 'w1_weak_low':'composite', 'w1_weak_medium':'composite', 'w2_medium_high':'composite', 'w2_medium_low':'composite', 'w2_medium_medium':'composite', 'w2_strong_high':'composite', 'w2_strong_low':'composite', 'w2_strong_medium':'composite', 'w2_weak_high':'composite', 'w2_weak_low':'composite', 'w2_weak_medium':'composite', 'w3_medium_high':'composite', 'w3_medium_low':'composite', 'w3_medium_medium':'composite', 'w3_strong_high':'composite', 'w3_strong_low':'composite', 'w3_strong_medium':'composite', 'w3_weak_high':'composite', 'w3_weak_low':'composite', 'w3_weak_medium':'composite', 'w4_medium_high':'composite', 'w4_medium_low':'composite', 'w4_medium_medium':'composite', 'w4_strong_high':'composite', 'w4_strong_low':'composite', 'w4_strong_medium':'composite', 'w4_weak_high':'composite', 'w4_weak_low':'composite', 'w4_weak_medium':'composite', 'w5_medium_high':'composite', 'w5_medium_low':'composite', 'w5_medium_medium':'composite', 'w5_strong_high':'composite', 'w5_strong_low':'composite', 'w5_strong_medium':'composite', 'w5_weak_high':'composite', 'w5_weak_low':'composite', 'w5_weak_medium':'composite', 'w6_medium_high':'composite', 'w6_medium_low':'composite', 'w6_medium_medium':'composite', 'w6_strong_high':'composite', 'w6_strong_low':'composite', 'w6_strong_medium':'composite', 'w6_weak_high':'composite', 'w6_weak_low':'composite', 'w6_weak_medium':'composite'}.get(arg('wind_preset'), arg('wind_type')))"/>
  <arg name="wind_constant_velocity_resolved" default="$(eval {'c1_low':'[0.0,0.0,0.0]', 'c2_medium':'[0.0,0.0,0.0]', 'c3_high':'[0.0,0.0,0.0]', 'w1_medium_high':'[5.000,0.000,0.000]', 'w1_medium_low':'[5.000,0.000,0.000]', 'w1_medium_medium':'[5.000,0.000,0.000]', 'w1_strong_high':'[9.000,0.000,0.000]', 'w1_strong_low':'[9.000,0.000,0.000]', 'w1_strong_medium':'[9.000,0.000,0.000]', 'w1_weak_high':'[2.000,0.000,0.000]', 'w1_weak_low':'[2.000,0.000,0.000]', 'w1_weak_medium':'[2.000,0.000,0.000]', 'w2_medium_high':'[0.000,0.000,5.000]', 'w2_medium_low':'[0.000,0.000,5.000]', 'w2_medium_medium':'[0.000,0.000,5.000]', 'w2_strong_high':'[0.000,0.000,9.000]', 'w2_strong_low':'[0.000,0.000,9.000]', 'w2_strong_medium':'[0.000,0.000,9.000]', 'w2_weak_high':'[0.000,0.000,2.000]', 'w2_weak_low':'[0.000,0.000,2.000]', 'w2_weak_medium':'[0.000,0.000,2.000]', 'w3_medium_high':'[3.536,3.536,0.000]', 'w3_medium_low':'[3.536,3.536,0.000]', 'w3_medium_medium':'[3.536,3.536,0.000]', 'w3_strong_high':'[6.364,6.364,0.000]', 'w3_strong_low':'[6.364,6.364,0.000]', 'w3_strong_medium':'[6.364,6.364,0.000]', 'w3_weak_high':'[1.414,1.414,0.000]', 'w3_weak_low':'[1.414,1.414,0.000]', 'w3_weak_medium':'[1.414,1.414,0.000]', 'w4_medium_high':'[2.887,2.887,2.887]', 'w4_medium_low':'[2.887,2.887,2.887]', 'w4_medium_medium':'[2.887,2.887,2.887]', 'w4_strong_high':'[5.196,5.196,5.196]', 'w4_strong_low':'[5.196,5.196,5.196]', 'w4_strong_medium':'[5.196,5.196,5.196]', 'w4_weak_high':'[1.155,1.155,1.155]', 'w4_weak_low':'[1.155,1.155,1.155]', 'w4_weak_medium':'[1.155,1.155,1.155]', 'w5_medium_high':'[5.000,5.000,0.000]', 'w5_medium_low':'[5.000,5.000,0.000]', 'w5_medium_medium':'[5.000,5.000,0.000]', 'w5_strong_high':'[9.000,9.000,0.000]', 'w5_strong_low':'[9.000,9.000,0.000]', 'w5_strong_medium':'[9.000,9.000,0.000]', 'w5_weak_high':'[2.000,2.000,0.000]', 'w5_weak_low':'[2.000,2.000,0.000]', 'w5_weak_medium':'[2.000,2.000,0.000]', 'w6_medium_high':'[2.887,-2.887,-2.887]', 'w6_medium_low':'[2.887,-2.887,-2.887]', 'w6_medium_medium':'[2.887,-2.887,-2.887]', 'w6_strong_high':'[5.196,-5.196,-5.196]', 'w6_strong_low':'[5.196,-5.196,-5.196]', 'w6_strong_medium':'[5.196,-5.196,-5.196]', 'w6_weak_high':'[1.155,-1.155,-1.155]', 'w6_weak_low':'[1.155,-1.155,-1.155]', 'w6_weak_medium':'[1.155,-1.155,-1.155]'}.get(arg('wind_preset'), arg('wind_constant_velocity')))"/>
  <arg name="wind_dryden_sigma_resolved" default="$(eval {'c1_low':'[0.6,0.6,0.3]', 'c2_medium':'[1.5,1.5,0.5]', 'c3_high':'[2.5,2.5,0.8]', 'w1_medium_high':'[2.5,2.5,0.8]', 'w1_medium_low':'[0.6,0.6,0.3]', 'w1_medium_medium':'[1.5,1.5,0.5]', 'w1_strong_high':'[2.5,2.5,0.8]', 'w1_strong_low':'[0.6,0.6,0.3]', 'w1_strong_medium':'[1.5,1.5,0.5]', 'w1_weak_high':'[2.5,2.5,0.8]', 'w1_weak_low':'[0.6,0.6,0.3]', 'w1_weak_medium':'[1.5,1.5,0.5]', 'w2_medium_high':'[2.5,2.5,0.8]', 'w2_medium_low':'[0.6,0.6,0.3]', 'w2_medium_medium':'[1.5,1.5,0.5]', 'w2_strong_high':'[2.5,2.5,0.8]', 'w2_strong_low':'[0.6,0.6,0.3]', 'w2_strong_medium':'[1.5,1.5,0.5]', 'w2_weak_high':'[2.5,2.5,0.8]', 'w2_weak_low':'[0.6,0.6,0.3]', 'w2_weak_medium':'[1.5,1.5,0.5]', 'w3_medium_high':'[2.5,2.5,0.8]', 'w3_medium_low':'[0.6,0.6,0.3]', 'w3_medium_medium':'[1.5,1.5,0.5]', 'w3_strong_high':'[2.5,2.5,0.8]', 'w3_strong_low':'[0.6,0.6,0.3]', 'w3_strong_medium':'[1.5,1.5,0.5]', 'w3_weak_high':'[2.5,2.5,0.8]', 'w3_weak_low':'[0.6,0.6,0.3]', 'w3_weak_medium':'[1.5,1.5,0.5]', 'w4_medium_high':'[2.5,2.5,0.8]', 'w4_medium_low':'[0.6,0.6,0.3]', 'w4_medium_medium':'[1.5,1.5,0.5]', 'w4_strong_high':'[2.5,2.5,0.8]', 'w4_strong_low':'[0.6,0.6,0.3]', 'w4_strong_medium':'[1.5,1.5,0.5]', 'w4_weak_high':'[2.5,2.5,0.8]', 'w4_weak_low':'[0.6,0.6,0.3]', 'w4_weak_medium':'[1.5,1.5,0.5]', 'w5_medium_high':'[2.5,2.5,0.8]', 'w5_medium_low':'[0.6,0.6,0.3]', 'w5_medium_medium':'[1.5,1.5,0.5]', 'w5_strong_high':'[2.5,2.5,0.8]', 'w5_strong_low':'[0.6,0.6,0.3]', 'w5_strong_medium':'[1.5,1.5,0.5]', 'w5_weak_high':'[2.5,2.5,0.8]', 'w5_weak_low':'[0.6,0.6,0.3]', 'w5_weak_medium':'[1.5,1.5,0.5]', 'w6_medium_high':'[2.5,2.5,0.8]', 'w6_medium_low':'[0.6,0.6,0.3]', 'w6_medium_medium':'[1.5,1.5,0.5]', 'w6_strong_high':'[2.5,2.5,0.8]', 'w6_strong_low':'[0.6,0.6,0.3]', 'w6_strong_medium':'[1.5,1.5,0.5]', 'w6_weak_high':'[2.5,2.5,0.8]', 'w6_weak_low':'[0.6,0.6,0.3]', 'w6_weak_medium':'[1.5,1.5,0.5]'}.get(arg('wind_preset'), arg('wind_dryden_sigma')))"/>
  <arg name="wind_dryden_length_scale_resolved" default="$(eval {'c1_low':'[12.0,12.0,6.0]', 'c2_medium':'[18.0,18.0,9.0]', 'c3_high':'[25.0,25.0,12.0]', 'w1_medium_high':'[25.0,25.0,12.0]', 'w1_medium_low':'[12.0,12.0,6.0]', 'w1_medium_medium':'[18.0,18.0,9.0]', 'w1_strong_high':'[25.0,25.0,12.0]', 'w1_strong_low':'[12.0,12.0,6.0]', 'w1_strong_medium':'[18.0,18.0,9.0]', 'w1_weak_high':'[25.0,25.0,12.0]', 'w1_weak_low':'[12.0,12.0,6.0]', 'w1_weak_medium':'[18.0,18.0,9.0]', 'w2_medium_high':'[25.0,25.0,12.0]', 'w2_medium_low':'[12.0,12.0,6.0]', 'w2_medium_medium':'[18.0,18.0,9.0]', 'w2_strong_high':'[25.0,25.0,12.0]', 'w2_strong_low':'[12.0,12.0,6.0]', 'w2_strong_medium':'[18.0,18.0,9.0]', 'w2_weak_high':'[25.0,25.0,12.0]', 'w2_weak_low':'[12.0,12.0,6.0]', 'w2_weak_medium':'[18.0,18.0,9.0]', 'w3_medium_high':'[25.0,25.0,12.0]', 'w3_medium_low':'[12.0,12.0,6.0]', 'w3_medium_medium':'[18.0,18.0,9.0]', 'w3_strong_high':'[25.0,25.0,12.0]', 'w3_strong_low':'[12.0,12.0,6.0]', 'w3_strong_medium':'[18.0,18.0,9.0]', 'w3_weak_high':'[25.0,25.0,12.0]', 'w3_weak_low':'[12.0,12.0,6.0]', 'w3_weak_medium':'[18.0,18.0,9.0]', 'w4_medium_high':'[25.0,25.0,12.0]', 'w4_medium_low':'[12.0,12.0,6.0]', 'w4_medium_medium':'[18.0,18.0,9.0]', 'w4_strong_high':'[25.0,25.0,12.0]', 'w4_strong_low':'[12.0,12.0,6.0]', 'w4_strong_medium':'[18.0,18.0,9.0]', 'w4_weak_high':'[25.0,25.0,12.0]', 'w4_weak_low':'[12.0,12.0,6.0]', 'w4_weak_medium':'[18.0,18.0,9.0]', 'w5_medium_high':'[25.0,25.0,12.0]', 'w5_medium_low':'[12.0,12.0,6.0]', 'w5_medium_medium':'[18.0,18.0,9.0]', 'w5_strong_high':'[25.0,25.0,12.0]', 'w5_strong_low':'[12.0,12.0,6.0]', 'w5_strong_medium':'[18.0,18.0,9.0]', 'w5_weak_high':'[25.0,25.0,12.0]', 'w5_weak_low':'[12.0,12.0,6.0]', 'w5_weak_medium':'[18.0,18.0,9.0]', 'w6_medium_high':'[25.0,25.0,12.0]', 'w6_medium_low':'[12.0,12.0,6.0]', 'w6_medium_medium':'[18.0,18.0,9.0]', 'w6_strong_high':'[25.0,25.0,12.0]', 'w6_strong_low':'[12.0,12.0,6.0]', 'w6_strong_medium':'[18.0,18.0,9.0]', 'w6_we